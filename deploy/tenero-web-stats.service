[Unit]
Description=Tenero website: write the network panel from the gamma seed
After=tenero-gamma.service

[Service]
Type=oneshot
User=tenero-gamma
ExecStart=/usr/bin/python3 -I /opt/tenero-web/tenero-web-stats.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/teneronetwork/stats
# it only ever talks to the node's control port on this machine
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
